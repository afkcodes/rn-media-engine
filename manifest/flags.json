    "divergences": [
      {
        "id": "mpv-audio-output-backend",
        "status": "intentional",
        "ref": "ARCHITECTURE.md 11",
        "reason": "The one AO each platform actually has. Android builds audiotrack; iOS builds audiounit. Everything else is off on both.",
        "flags": [
          "-Daudiotrack=enabled",
          "-Daudiotrack=disabled",
          "-Daudiounit=enabled"
        ]
      },
      {
        "id": "mpv-exhaustive-disable-list",
        "status": "bug",
        "ref": "rn-media task #32; research D5(b); libmpv-darwin-build nix/packages/mk-pkg-mpv/default.nix:140-144",
        "reason": "Darwin names and disables every mpv meson option it does not want; Android names 27 and leaves the remaining ~73 at their upstream default, which for most mpv features is `auto`. Android is therefore protected only by the NDK sysroot not happening to satisfy a dependency probe. That is exactly the hazard the darwin fork already hit and wrote down: -Davfoundation was NEW in mpv 0.41 with value `auto`, and its dependency resolves on iOS as well as macOS, so left alone it silently built a SECOND audio output into an audio-only engine. The next mpv release can do the same to Android with any option whose deps the NDK provides. Fix: give the Android build the same exhaustive list, and let `workshop dry-run` diff the candidate meson options against it on every bump.",
        "flags": [
          "-Dalsa=disabled",
          "-Davfoundation=disabled",
          "-Dbuild-date=true",
          "-Dcaca=disabled",
          "-Dcdda=disabled",
          "-Dcocoa=disabled",
          "-Dcoreaudio=disabled",
          "-Dcuda-hwaccel=disabled",
