    "divergences": [
      {
        "id": "ffmpeg-disable-all-idiom",
        "status": "intentional",
        "ref": "libmpv-android-audio-build buildscripts/scripts/ffmpeg.sh; libmpv-darwin-build nix/packages/mk-pkg-ffmpeg/meson.build:27",
        "reason": "Same intent, two spellings. Darwin reaches \"the allow-list is the whole world\" with --disable-all --disable-autodetect; Android enumerates the component classes and the autodetected libraries one by one. Identical outcome, and the enumerated form is arguably better documentation — but it is also why a naive diff of the two configure lines is useless, which is what this manifest exists to fix.",
        "flags": [
          "--disable-decoders",
          "--disable-demuxers",
          "--disable-encoders",
          "--disable-muxers",
          "--disable-parsers",
          "--disable-protocols",
          "--disable-filters",
          "--disable-devices",
          "--disable-bsfs",
          "--disable-doc",
          "--disable-programs",
          "--disable-avdevice",
          "--disable-gray",
          "--disable-swscale-alpha",
          "--disable-bzlib",
          "--disable-iconv",
          "--disable-vulkan",
          "--disable-dxva2",
          "--disable-vaapi",
          "--disable-vdpau",
          "--disable-linux-perf",
          "--disable-all",
          "--disable-autodetect"
        ]
      },
      {
        "id": "ffmpeg-android-native",
        "status": "intentional",
        "ref": "patches/001-lavc-set-java-vm",
        "reason": "--enable-jni is what makes libavcodec able to reach the JVM, and is the whole reason patch 001 exists. --disable-mediacodec keeps the hardware VIDEO decoder out of an audio engine; --disable-videotoolbox is the Apple counterpart Android must not have. None of these has a meaningful darwin equivalent.",
        "flags": [
          "--enable-jni",
          "--disable-mediacodec",
          "--disable-videotoolbox"
        ]
      },
      {
        "id": "ffmpeg-audio-output-backend",
        "status": "intentional",
        "ref": "ARCHITECTURE.md 11",
        "reason": "AudioToolbox is the Apple resampler/codec path and has no Android counterpart; Android disables it explicitly and darwin enables it. This is the platform ceiling being platform-shaped, not drift.",
        "flags": [
          "--disable-audiotoolbox",
          "--enable-audiotoolbox"
        ]
      },
      {
        "id": "ffmpeg-build-shape",
        "status": "intentional",
        "ref": "libmpv-android-audio-build buildscripts/scripts/mpv.sh; libmpv-darwin-build nix/packages/mk-pkg-ffmpeg",
        "reason": "The two forks link FFmpeg differently and always have: Android builds static FFmpeg archives and links them into one libmpv.so (hence --enable-static plus the version script), darwin ships FFmpeg as separate dylibs inside the xcframework (hence --enable-shared --enable-pic). Everything here follows from that one decision. --disable-x86asm is arm-only cross-compilation; the stripping/optimization/pthreads pairs are darwin re-enabling in common_options what disable_all_options turned off.",
        "flags": [
          "--enable-static",
          "--enable-avutil",
          "--enable-hwaccels",
          "--enable-shared",
          "--disable-static",
          "--enable-pic",
          "--disable-x86asm",
          "--disable-debug",
          "--disable-optimizations",
          "--disable-stripping",
          "--enable-stripping",
          "--disable-pthreads",
          "--enable-pthreads",
          "--disable-safe-bitstream-reader",
          "--enable-safe-bitstream-reader"
        ]
      },
      {
        "id": "ffmpeg-runtime-cpudetect",
        "status": "intentional",
        "ref": "libmpv-android-audio-build buildscripts/scripts/ffmpeg.sh",
        "reason": "Android ships four ABIs including armeabi-v7a, where the NEON/VFP baseline genuinely varies between devices, so runtime detection earns its size. Every Apple target we ship is arm64 with a fixed feature baseline, so darwin turns it off and takes the smaller binary.",
        "flags": [
          "--enable-runtime-cpudetect",
          "--disable-runtime-cpudetect"
        ]
      },
      {
        "id": "ffmpeg-image-encoders",
        "status": "bug",
        "ref": "rn-media task #32",
        "reason": "Android enables five image ENCODERS in an audio-only engine and darwin enables none. Nothing in rn-media encodes an image. Either they exist to re-encode cover art somewhere and darwin needs them, or they are dead weight inherited from the upstream flavour script and Android should drop them. Undecided is the bug; both platforms agreeing is the fix.",
        "flags": [
          "--enable-encoder=jpeg2000",
          "--enable-encoder=jpegls",
          "--enable-encoder=ljpeg",
          "--enable-encoder=mjpeg",
          "--enable-encoder=png"
        ]
      },
      {
        "id": "ffmpeg-libxml2",
        "status": "bug",
        "ref": "rn-media task #32; manifest/engine.json repoDivergences/libxml2-scope",
        "reason": "Android links libxml2 into every build; darwin only into the video variant (--enable-libxml2 lives in video_common_options). libxml2 in FFmpeg carries the DASH demuxer and nothing an audio engine needs, so the likely fix is to drop it from Android rather than add it to darwin — but the two must agree, and today one of them ships an XML parser the other does not.",
        "flags": [
          "--enable-libxml2"
        ]
      }
    ],
    "resolved": [
      {
        "id": "ffmpeg-cover-art-decoders",
        "release": "rn-media task #32 (parity release)",
        "how": "darwin audio_default_options gained bmp gif jpeg2000 jpegls mjpeg png tiff webp. EIGHT, not the nine Android had: --enable-decoder=ljpeg matches nothing in any FFmpeg (ljpeg is an encoder only) and was deleted from Android rather than copied here."
      },
      {
        "id": "ffmpeg-lossless-audio",
        "release": "rn-media task #32 (parity release)",
        "how": "darwin gained --enable-decoder=truehd and --enable-demuxer=dtshd; it already had the truehd demuxer and the dca decoder, so a .thd demuxed and then failed to decode."
      },
      {
        "id": "ffmpeg-zlib",
        "release": "rn-media task #32 (parity release)",
        "how": "Android gained --enable-zlib (Matroska compressed track headers). Free: the NDK sysroot ships zlib.h and libz.so at API 21, so it adds one DT_NEEDED and no vendored source."
      },
      {
        "id": "ffmpeg-lgpl-polarity",
        "release": "rn-media task #32 (parity release)",
        "how": "darwin common_options now ASSERTS --disable-gpl --disable-nonfree instead of leaving them commented out. Both forks now state the licence rather than one stating it and the other omitting the opposite."
      },
      {
        "id": "ffmpeg-dead-flags",
        "release": "rn-media task #32 (parity release)",
        "how": "Deleted on BOTH forks rather than propagated: --enable-decoder=ljpeg and --enable-protocol=srt (Android), --enable-protocol=hls (both). All three matched nothing in FFmpeg 8.1.2 and configure warned about them on every build."
      }
    ]
  },
