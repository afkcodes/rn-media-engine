_mpv_event_to_node
_mpv_free
_mpv_free_node_contents
_mpv_get_property
_mpv_get_property_async
_mpv_get_property_osd_string
_mpv_get_property_string
_mpv_get_time_ns
_mpv_get_time_us
_mpv_get_wakeup_pipe
_mpv_hook_add
_mpv_hook_continue
